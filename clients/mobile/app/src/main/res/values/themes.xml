<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Hush" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors - используем @color/primary -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.Hush.ActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="background">@color/primary</item>
        <item name="titleTextColor">@color/white</item>
    </style>
</resources>